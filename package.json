    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyland-zero/pi-copilot-style.git"
  },
  "homepage": "https://github.com/skyland-zero/pi-copilot-style#readme",
  "bugs": {
    "url": "https://github.com/skyland-zero/pi-copilot-style/issues"
  }
}
