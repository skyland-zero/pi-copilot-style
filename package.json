{
  "name": "pi-copilot-style",
  "version": "0.5.0",
  "description": "GitHub Copilot CLI's look for pi: one-line tool rows, ❯ / ● message chrome, thinking labels, and the Copilot light/dark palettes",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "copilot",
    "tool-rows",
    "theme"
  ],
  "license": "MIT",
  "author": "skyland-zero",
